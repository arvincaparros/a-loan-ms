# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# SQL Server connection. Defaults in app/core/config.py already target a
# local, Windows-authenticated SQL Server instance (DB_TRUSTED_CONNECTION=true),
# so none of these need to be set for local development unless you want to
# override them.
DB_SERVER=localhost
DB_NAME=ALoanMS
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=true
DB_TRUST_SERVER_CERTIFICATE=true

# Only needed if DB_TRUSTED_CONNECTION=false (SQL Server authentication
# instead of Windows authentication). Never commit real values here.
DB_USERNAME=
DB_PASSWORD=

# Postgres connection (Phase 2 migration target; this is the live app's
# primary database going forward). Never commit real values here.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ALoanMS
POSTGRES_USER=aloanms
POSTGRES_PASSWORD=
# "disable" is fine for local Docker dev; any non-local environment must
# use "require" or "verify-full" instead.
POSTGRES_SSLMODE=disable
